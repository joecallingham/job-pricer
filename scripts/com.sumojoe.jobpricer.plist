<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts the Job Pricer at login and restarts it if it stops. Not installed by default:
     cp scripts/com.sumojoe.jobpricer.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.sumojoe.jobpricer.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sumojoe.jobpricer</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/joe/.nvm/versions/node/v26.13.0/bin/node</string>
    <string>/Users/joe/Projects/job-pricer/server.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/joe/Projects/job-pricer</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/joe/Projects/job-pricer/server.log</string>
  <key>StandardErrorPath</key><string>/Users/joe/Projects/job-pricer/server.log</string>
</dict>
</plist>
